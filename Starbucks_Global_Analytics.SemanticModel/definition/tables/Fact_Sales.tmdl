table Fact_Sales
	lineageTag: 56570d2e-7643-bda9-21bf-e2b2d4f35354

	measure 'Net sales' = SUM ( Fact_Sales[Net sales amount] )
		formatString: $#,0.0K
		displayFolder: 01 Store sales
		lineageTag: ae5fd284-ec4a-ee30-fa15-96d638f9d9fb

	measure 'Net sales latest' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Net sales], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) + 0
		formatString: $#,0.0K
		displayFolder: 01 Store sales
		lineageTag: 0bf5ee41-bb21-351c-2ac9-c7634c9eb7b0

	measure 'Net sales PY' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Net sales], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y - 1 ) + 0
		formatString: $#,0.0K
		displayFolder: 01 Store sales
		lineageTag: a54174b2-fc43-96d1-c9e0-1e2e0f61b58c

	measure 'Net sales YoY' = DIVIDE ( [Net sales latest] - [Net sales PY], [Net sales PY] )
		formatString: +0.0%;-0.0%;"—"
		displayFolder: 02 Growth
		lineageTag: e26a793b-b4d1-247c-8b15-ef715be291ca

	measure 'Net sales delta label' = VAR d = [Net sales YoY] RETURN IF ( ISBLANK ( d ), "", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs prior FY" )
		formatString: @
		displayFolder: 02 Growth
		lineageTag: 55c5677d-aecb-a4b4-0081-4f0b57982aed

	measure Orders = DISTINCTCOUNT ( Fact_Sales[OrderID] )
		formatString: #,0
		displayFolder: 01 Store sales
		lineageTag: 7442e29d-7d53-e549-b78d-93c46b8cdcfc

	measure 'Orders latest' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Orders], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) + 0
		formatString: #,0
		displayFolder: 01 Store sales
		lineageTag: cf317a78-422a-66e4-ff2c-5628a1aa3b94

	measure 'Units sold' = SUM ( Fact_Sales[Quantity] )
		formatString: #,0
		displayFolder: 01 Store sales
		lineageTag: 7d18e272-01bc-ffbf-5cf1-41090e158fa2

	measure 'Units latest' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Units sold], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) + 0
		formatString: #,0
		displayFolder: 01 Store sales
		lineageTag: 71bddfce-a5ad-15aa-6389-e8598e196390

	measure 'Average ticket' = DIVIDE ( [Net sales], [Orders] )
		formatString: $#,0.00
		displayFolder: 01 Store sales
		lineageTag: 503aa1f5-c6b7-5b04-f1c8-523d286b6346

	measure 'Average ticket latest' = DIVIDE ( [Net sales latest], [Orders latest] )
		formatString: $#,0.00
		displayFolder: 01 Store sales
		lineageTag: 96697da8-e467-42e8-1114-fda333e1f0b6

	measure 'Gross profit' = SUM ( Fact_Sales[Gross profit amount] )
		formatString: $#,0.0K
		displayFolder: 01 Store sales
		lineageTag: 0ae03b9d-8106-dc65-e127-9bf0bd85e56d

	measure 'Gross margin' = DIVIDE ( [Gross profit], [Net sales] )
		formatString: 0.0%
		displayFolder: 01 Store sales
		lineageTag: ad2b02ef-3f96-ea9a-346c-972e6a58ab9d

	measure 'Gross margin latest' = DIVIDE ( CALCULATE ( [Gross profit], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = MAX ( Dim_Year[Year] ) ), [Net sales latest] )
		formatString: 0.0%
		displayFolder: 01 Store sales
		lineageTag: c4df5042-0915-0333-b8d4-3b3253e68384

	measure 'Discount rate' = DIVIDE ( SUM ( Fact_Sales[Gross sales] ) - SUM ( Fact_Sales[Net sales amount] ), SUM ( Fact_Sales[Gross sales] ) )
		formatString: 0.0%
		displayFolder: 01 Store sales
		lineageTag: 9e57c2db-cace-a5e2-e8aa-3edde11cf976

	measure 'Net sales per store' = DIVIDE ( [Net sales latest], [Stores] )
		formatString: $#,0.0K
		displayFolder: 03 Footprint
		lineageTag: b307fe3d-b57e-a037-0627-41c659c497c4

	measure 'Top product sales' = VAR r = RANKX ( ALL ( Dim_Product[Product] ), [Net sales], , DESC, Dense ) RETURN IF ( r <= 5, [Net sales] )
		formatString: $#,0.0K
		displayFolder: 05 Product mix
		lineageTag: bd79b60b-2744-a719-c7e1-a843814533db

	measure 'Net sales (K)' = DIVIDE ( SUM ( Fact_Sales[Net sales amount] ), 1000 )
		formatString: $#,0.0K
		displayFolder: 01 Store sales
		lineageTag: 873d444e-5c9a-2df4-a4cd-a448e3e75a48

	measure 'Net sales text' = FORMAT ( DIVIDE ( [Net sales latest], 1000 ), "$#,0.0""K""" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 79334ada-69ab-4dae-23f6-10ae204d1dbb

	measure 'Orders text' = FORMAT ( [Orders latest], "#,0" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: d77e42e3-8974-ef30-40bc-c5c10dff6913

	measure 'Units text' = FORMAT ( [Units latest], "#,0" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 8781219b-e299-abe2-03d3-804cdcc8a62e

	measure 'Average ticket text' = FORMAT ( [Average ticket latest], "$#,0.00" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 4892fef2-faae-7780-8a78-58ec37f8ec6e

	measure 'Gross margin text' = FORMAT ( [Gross margin latest], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: dab17d22-ffef-ddec-c91a-791cf8981bf3

