	partition Dim_Date = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2021, 1, 1 ), DATE ( 2026, 12, 31 ) ), "DateKey", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "MonthNo", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMMM" ), "YearMonth", FORMAT ( [Date], "yyyy-MM" ), "Day", DAY ( [Date] ), "DayName", FORMAT ( [Date], "dddd" ), "DayOfWeek", WEEKDAY ( [Date], 2 ), "Is Weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, 1, 0 ) )