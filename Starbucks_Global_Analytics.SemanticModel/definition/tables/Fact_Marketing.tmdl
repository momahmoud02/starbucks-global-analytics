table Fact_Marketing
	lineageTag: 1c675d27-89f9-9654-8231-83d3fd73d91d

	measure 'Marketing spend' = SUM ( Fact_Marketing[Spend] )
		formatString: $#,0.0M
		displayFolder: 01 Marketing
		lineageTag: e4663848-1436-1985-8ed8-e213f46950f6

	measure 'Marketing spend (M)' = DIVIDE ( SUM ( Fact_Marketing[Spend] ), 1000000 )
		formatString: $#,0.0M
		displayFolder: 01 Marketing
		lineageTag: c756a960-9c8b-a59f-1b05-6778a847b34e

	measure 'Marketing spend latest' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Marketing spend], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) + 0
		formatString: $#,0.0M
		displayFolder: 01 Marketing
		lineageTag: 29309d9c-efb4-491c-5135-d166462489ae

	measure Impressions = SUM ( Fact_Marketing[Impressions count] )
		formatString: #,0.0,,"M"
		displayFolder: 01 Marketing
		lineageTag: 6cdec37e-da6a-c1ee-c892-e4bf19aaa78c

	measure Clicks = SUM ( Fact_Marketing[Clicks count] )
		formatString: #,0.0,,"M"
		displayFolder: 01 Marketing
		lineageTag: cbdb553a-aace-16e7-7bb2-05e9bc3375ef

	measure 'Attributed orders' = SUM ( Fact_Marketing[Attributed orders count] )
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: 612ee8ff-3cf8-8bfa-0051-dc6b464f52c0

	measure CTR = DIVIDE ( [Clicks], [Impressions] )
		formatString: 0.00%
		displayFolder: 01 Marketing
		lineageTag: ff2a7a54-18a4-9af6-4a57-ef3cf31d7721

	measure CPA = DIVIDE ( [Marketing spend], [Attributed orders] )
		formatString: $#,0.00
		displayFolder: 01 Marketing
		lineageTag: 787df3c9-29e1-66f3-f27c-5208e45c23d3

	measure 'CTR latest' = VAR y = MAX ( Dim_Year[Year] ) VAR c = CALCULATE ( [Clicks], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) VAR i = CALCULATE ( [Impressions], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) RETURN DIVIDE ( c, i )
		formatString: 0.00%
		displayFolder: 01 Marketing
		lineageTag: a2bae751-f17d-d816-7920-919b2e7c1712

	measure 'CPA latest' = VAR y = MAX ( Dim_Year[Year] ) VAR s = CALCULATE ( [Marketing spend], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) VAR o = CALCULATE ( [Attributed orders], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) RETURN DIVIDE ( s, o )
		formatString: $#,0.00
		displayFolder: 01 Marketing
		lineageTag: 91e9b6e5-ad3c-63b4-aed3-7043c0eb261c

	measure 'Marketing spend text' = FORMAT ( DIVIDE ( [Marketing spend], 1000000 ), "$#,0.0""M""" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 8c6320ce-2982-303a-7abf-cc893597fbf8

