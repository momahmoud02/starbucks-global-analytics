		mode: import
		source = DATATABLE ( "Year", INTEGER, "FY", STRING, { {2021, "FY2021"}, {2022, "FY2022"}, {2023, "FY2023"}, {2024, "FY2024"}, {2025, "FY2025"}, {2026, "FY2026"} } )