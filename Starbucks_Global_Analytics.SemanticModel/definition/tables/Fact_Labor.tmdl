table Fact_Labor
	lineageTag: f61bdb0c-dd64-9a8e-c1e8-348b48ec29f0

	measure 'Labor cost' = SUM ( Fact_Labor[Labor cost amount] )
		formatString: $#,0.0M
		displayFolder: 01 Workforce
		lineageTag: 27136948-13bd-d885-0a28-e95cb580c65d

	measure 'Labor cost (M)' = DIVIDE ( SUM ( Fact_Labor[Labor cost amount] ), 1000000 )
		formatString: $#,0.0M
		displayFolder: 01 Workforce
		lineageTag: 542f1c6b-c0b7-6dc4-2811-20403dcb44df

	measure 'Labor cost latest' = VAR y = MAX ( Dim_Year[Year] ) RETURN CALCULATE ( [Labor cost], REMOVEFILTERS ( Dim_Year ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = y ) + 0
		formatString: $#,0.0M
		displayFolder: 01 Workforce
		lineageTag: 87a4003c-ce68-5f88-6980-2d81c2ce4caa

	measure 'Labor hours' = SUM ( Fact_Labor[Actual hours] )
		formatString: #,0.0,,"M"
		displayFolder: 01 Workforce
		lineageTag: dd988163-1c7c-5acf-56d6-fe897be7dfde

	measure 'Cost per hour' = DIVIDE ( [Labor cost], [Labor hours] )
		formatString: $#,0.00
		displayFolder: 01 Workforce
		lineageTag: dbc1fda8-1571-f16f-6ba8-95280e15c0ea

	measure 'Overtime rate' = DIVIDE ( SUM ( Fact_Labor[Overtime hours worked] ), SUM ( Fact_Labor[Actual hours] ) )
		formatString: 0.0%
		displayFolder: 01 Workforce
		lineageTag: 5e7c35a6-49f1-2edb-2e41-125d761b1ef0

	measure 'Absence rate' = DIVIDE ( SUM ( Fact_Labor[Absence hours logged] ), SUM ( Fact_Labor[Scheduled hours] ) )
		formatString: 0.0%
		displayFolder: 01 Workforce
		lineageTag: 4a3d8bb3-0128-8c4c-2148-f8841afdefe9

	measure 'Overtime hours' = SUM ( Fact_Labor[Overtime hours worked] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 31ba1c3f-fb4f-cbf2-bade-27471dbc5c82

	measure 'Absence hours' = SUM ( Fact_Labor[Absence hours logged] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 9f1e0a6a-e304-d19f-6dc0-679b8a972eff

	measure 'Labor cost text' = FORMAT ( DIVIDE ( [Labor cost], 1000000 ), "$#,0.0""M""" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 5d526963-1138-b7e2-f73d-1a72dbc12ea4

	measure 'Labor hours text' = FORMAT ( DIVIDE ( [Labor hours], 1000000 ), "#,0.0""M""" )
