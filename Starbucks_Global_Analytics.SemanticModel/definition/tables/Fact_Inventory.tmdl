table Fact_Inventory
	lineageTag: 197fab4b-376f-57dd-0840-7c79687cfab2

	measure 'Inventory value' = SUM ( Fact_Inventory[Closing value] )
		formatString: $#,0.0K
		displayFolder: 01 Inventory
		lineageTag: ad47aa91-59a9-c9eb-4d4e-5a3b8282a082

	measure 'Inventory value (K)' = DIVIDE ( SUM ( Fact_Inventory[Closing value] ), 1000 )
		formatString: $#,0.0K
		displayFolder: 01 Inventory
		lineageTag: 83a74241-2419-99d7-c4ad-caf8bec001ae

	measure 'Inventory value latest' = VAR m = CALCULATE ( MAX ( Fact_Inventory[MonthDateKey] ), REMOVEFILTERS ( Dim_Date ) ) RETURN CALCULATE ( [Inventory value], REMOVEFILTERS ( Dim_Date ), Fact_Inventory[MonthDateKey] = m ) + 0
		formatString: $#,0.0K
		displayFolder: 01 Inventory
		lineageTag: 9d3fbe29-3139-58dc-dc9d-f5d0160cc20a

	measure 'Sell-through' = DIVIDE ( SUM ( Fact_Inventory[Units sold] ), SUM ( Fact_Inventory[Opening units] ) + SUM ( Fact_Inventory[Received units] ) )
		formatString: 0.0%
		displayFolder: 01 Inventory
		lineageTag: d0d1dbd9-058d-2482-de23-3ac87b21b018

	measure 'Waste rate' = DIVIDE ( SUM ( Fact_Inventory[Waste units logged] ), SUM ( Fact_Inventory[Units sold] ) )
		formatString: 0.0%
		displayFolder: 01 Inventory
		lineageTag: 9b5209f8-806e-8aa3-b7fb-c25a9496908f

	measure 'Months of supply' = DIVIDE ( SUM ( Fact_Inventory[Closing units on hand] ), SUM ( Fact_Inventory[Units sold] ) )
		formatString: 0.0
		displayFolder: 01 Inventory
		lineageTag: 37d4de46-79bc-8893-2c0b-03953c79ceee

	measure 'Stockout rate' = AVERAGE ( Fact_Inventory[Stockout rate %] )
		formatString: 0.00%
		displayFolder: 01 Inventory
		lineageTag: 817c43fb-9727-2a65-0a42-37cf81a770a2

	measure 'Waste units' = SUM ( Fact_Inventory[Waste units logged] )
		formatString: #,0
		displayFolder: 01 Inventory
		lineageTag: e6ef70ee-85d2-d12b-8e33-b045a0d71086

	measure 'Closing units' = SUM ( Fact_Inventory[Closing units on hand] )
		formatString: #,0
		displayFolder: 01 Inventory
		lineageTag: 81ffddf2-f080-2bc6-ddaa-86cc2a0e9dbe

	measure 'Inventory value text' = FORMAT ( DIVIDE ( [Inventory value latest], 1000 ), "$#,0.0""K""" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 36833512-1c8a-434f-ae11-cd7675ba83b7

	measure 'Sell-through text' = FORMAT ( [Sell-through], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 1cc474d3-0572-8e0e-20ac-12ca6ce07c6b

	measure 'Waste rate text' = FORMAT ( [Waste rate], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 24f1295a-0f15-8e16-0ef4-b3b48847e1f4

	measure 'Months of supply text' = FORMAT ( [Months of supply], "0.0" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 65e7ce84-b89c-88c1-a982-eb768dd1c558

	measure 'Stockout text' = FORMAT ( [Stockout rate], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 21322245-145d-3480-0ce9-95fb8081ab05

