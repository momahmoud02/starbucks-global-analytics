	measure 'Net earnings text' = FORMAT ( DIVIDE ( [Net earnings latest reported], 1000 ), "$#,0.0""B""" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 00bdf6b3-ff30-515b-6f6c-210f443d3a22

	measure 'Operating margin text' = FORMAT ( [Operating margin latest], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: ce539e4e-5e12-6abb-5c13-7b7cb85edcca

	measure 'Revenue CAGR text' = FORMAT ( [Revenue CAGR], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: fe62c51d-df2b-145e-6142-5975e9ca1e5f

	measure 'Licensed share text' = FORMAT ( [Licensed share latest], "0.0%" )
		formatString: @
		displayFolder: 09 Display
		lineageTag: 7976920c-9032-14f3-7545-18d1949a5ad7

