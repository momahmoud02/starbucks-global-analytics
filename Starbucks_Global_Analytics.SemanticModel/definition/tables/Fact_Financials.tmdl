		source = DATATABLE ( "Fiscal year", INTEGER, "Fiscal year end", STRING, "Total revenue", DOUBLE, "Operating income", DOUBLE, "Net earnings", DOUBLE, "Company-operated revenue", DOUBLE, "Licensed revenue", DOUBLE, "Other revenue", DOUBLE, { {2021, "2021-10-03", 29060.6, 4872.1, 4199.3, 24607, 2683.6, 1770}, {2022, "2022-10-02", 32250.3, 4617.8, 3281.6, 26576.1, 3655.5, 2018.7}, {2023, "2023-10-01", 35975.6, 5870.8, 4124.5, 29462.3, 4512.7, 2000.6}, {2024, "2024-09-29", 36176.2, 5408.8, 3760.9, 29765.9, 4505.1, 1905.2}, {2025, "2025-09-28", 37184.4, 2936.6, 1856.4, 30744.8, 4350.4, 2089.2}, {2026, "2026-09-27", 37910.6, 3691.1, 0, 30940.2, 4615.8, 2354.6} } )